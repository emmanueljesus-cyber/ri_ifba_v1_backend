# ==================================================
# CONFIGURAÇÕES DOCKER - DESENVOLVIMENTO
# ==================================================

# Aplicação
APP_NAME=ri_ifba_v1_backend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Banco de Dados PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ri_ifba_v1
DB_USERNAME=postgres
DB_PASSWORD=201099

# Porta externa do PostgreSQL (para evitar conflito com instalação local)
DB_PORT_EXTERNAL=54320

# Redis (Cache & Queue)
REDIS_HOST=redis
REDIS_PASSWORD=redis
REDIS_PORT=6379

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Adminer (Gerenciador de Banco)
ADMINER_PORT=8080

# IDs de usuário (para permissões corretas)
USER_ID=1000
GROUP_ID=1000

# Mail (Desenvolvimento)
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ifba.edu.br"
MAIL_FROM_NAME="${APP_NAME}"

# Locale
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=debug

