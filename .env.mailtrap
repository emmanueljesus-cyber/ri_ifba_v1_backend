# ========================================
# CONFIGURAÇÃO MAILTRAP (SMTP)
# ========================================
# 1. Crie conta em: https://mailtrap.io
# 2. Acesse Email Sending > Domains
# 3. Clique em "Add Domain" ou use sandbox
# 4. Copie as credenciais SMTP

MAIL_MAILER=smtp
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=SEU_TOKEN_AQUI
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ifba.edu.br"
MAIL_FROM_NAME="${APP_NAME}"
