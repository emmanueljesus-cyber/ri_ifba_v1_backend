APP_NAME=ri_ifba_v1_backend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==========================
# Banco de dados
# ==========================
DB_CONNECTION=pgsql

# Local sem Docker:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ri_ifba_v1
DB_USERNAME=postgres
DB_PASSWORD=

# Se estiver usando Docker Compose, troque para:
# DB_HOST=postgres
# DB_PASSWORD=postgres
