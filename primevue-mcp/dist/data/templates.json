{
  "crud-page": {
    "description": "Página CRUD completa com listagem, criar, editar e deletar",
    "template": "<template>\n  <div class=\"crud-page\">\n    <Toast />\n    \n    <div class=\"card\">\n      <div class=\"flex justify-content-between mb-4\">\n        <h2>{{entityName}}</h2>\n        <Button label=\"Novo\" icon=\"pi pi-plus\" @click=\"openDialog\" />\n      </div>\n\n      <DataTable \n        :value=\"items\" \n        :loading=\"loading\"\n        paginator \n        :rows=\"10\"\n        :rowsPerPageOptions=\"[5,10,20,50]\"\n        filterDisplay=\"row\"\n        v-model:selection=\"selectedItem\"\n        selectionMode=\"single\"\n      >\n        <Column field=\"id\" header=\"ID\" sortable></Column>\n        <Column field=\"name\" header=\"Nome\" sortable></Column>\n        <Column field=\"status\" header=\"Status\" sortable>\n          <template #body=\"slotProps\">\n            <Tag :severity=\"getSeverity(slotProps.data.status)\" :value=\"slotProps.data.status\" />\n          </template>\n        </Column>\n        <Column header=\"Ações\">\n          <template #body=\"slotProps\">\n            <Button icon=\"pi pi-pencil\" class=\"p-button-rounded p-button-text\" @click=\"editItem(slotProps.data)\" />\n            <Button icon=\"pi pi-trash\" class=\"p-button-rounded p-button-text p-button-danger\" @click=\"deleteItem(slotProps.data)\" />\n          </template>\n        </Column>\n      </DataTable>\n    </div>\n\n    <Dialog v-model:visible=\"dialogVisible\" :header=\"editing ? 'Editar' : 'Novo'\" :modal=\"true\" :style=\"{width: '450px'}\">\n      <div class=\"flex flex-column gap-3 mt-3\">\n        <div class=\"field\">\n          <label for=\"name\">Nome</label>\n          <InputText id=\"name\" v-model=\"form.name\" class=\"w-full\" />\n        </div>\n        \n        <div class=\"field\">\n          <label for=\"status\">Status</label>\n          <Dropdown id=\"status\" v-model=\"form.status\" :options=\"statusOptions\" class=\"w-full\" />\n        </div>\n      </div>\n\n      <template #footer>\n        <Button label=\"Cancelar\" icon=\"pi pi-times\" @click=\"dialogVisible = false\" text />\n        <Button label=\"Salvar\" icon=\"pi pi-check\" @click=\"save\" :loading=\"saving\" />\n      </template>\n    </Dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue';\nimport { useToast } from 'primevue/usetoast';\nimport DataTable from 'primevue/datatable';\nimport Column from 'primevue/column';\nimport Button from 'primevue/button';\nimport Dialog from 'primevue/dialog';\nimport InputText from 'primevue/inputtext';\nimport Dropdown from 'primevue/dropdown';\nimport Tag from 'primevue/tag';\nimport Toast from 'primevue/toast';\n\nconst toast = useToast();\nconst items = ref([]);\nconst loading = ref(false);\nconst dialogVisible = ref(false);\nconst editing = ref(false);\nconst saving = ref(false);\nconst selectedItem = ref(null);\n\nconst form = ref({\n  id: null,\n  name: '',\n  status: 'Ativo'\n});\n\nconst statusOptions = ['Ativo', 'Inativo', 'Pendente'];\n\nasync function loadItems() {\n  loading.value = true;\n  try {\n    // const response = await fetch('/api/{{entityName}}');\n    // items.value = await response.json();\n    // Mock data:\n    items.value = [\n      {id: 1, name: 'Item 1', status: 'Ativo'},\n      {id: 2, name: 'Item 2', status: 'Pendente'},\n      {id: 3, name: 'Item 3', status: 'Ativo'}\n    ];\n  } catch (error) {\n    toast.add({severity: 'error', summary: 'Erro', detail: 'Falha ao carregar', life: 3000});\n  } finally {\n    loading.value = false;\n  }\n}\n\nfunction openDialog() {\n  editing.value = false;\n  form.value = {id: null, name: '', status: 'Ativo'};\n  dialogVisible.value = true;\n}\n\nfunction editItem(item) {\n  editing.value = true;\n  form.value = {...item};\n  dialogVisible.value = true;\n}\n\nasync function save() {\n  saving.value = true;\n  try {\n    // API call here\n    toast.add({severity: 'success', summary: 'Sucesso', detail: 'Salvo com sucesso', life: 3000});\n    dialogVisible.value = false;\n    loadItems();\n  } catch (error) {\n    toast.add({severity: 'error', summary: 'Erro', detail: 'Falha ao salvar', life: 3000});\n  } finally {\n    saving.value = false;\n  }\n}\n\nasync function deleteItem(item) {\n  if (confirm('Deseja realmente excluir?')) {\n    try {\n      // API call here\n      toast.add({severity: 'success', summary: 'Sucesso', detail: 'Excluído', life: 3000});\n      loadItems();\n    } catch (error) {\n      toast.add({severity: 'error', summary: 'Erro', detail: 'Falha ao excluir', life: 3000});\n    }\n  }\n}\n\nfunction getSeverity(status) {\n  const map = {\n    'Ativo': 'success',\n    'Inativo': 'danger',\n    'Pendente': 'warning'\n  };\n  return map[status] || 'info';\n}\n\nonMounted(() => {\n  loadItems();\n});\n</script>\n\n<style scoped>\n.crud-page {\n  padding: 1rem;\n}\n</style>"
  },
  "login-page": {
    "description": "Página de login responsiva",
    "template": "<template>\n  <div class=\"flex align-items-center justify-content-center min-h-screen bg-gray-100\">\n    <Toast />\n    \n    <Card style=\"width: 400px\">\n      <template #title>\n        <div class=\"text-center\">\n          <h2>Login</h2>\n        </div>\n      </template>\n      \n      <template #content>\n        <form @submit.prevent=\"handleLogin\" class=\"flex flex-column gap-3\">\n          <div class=\"field\">\n            <label for=\"email\">Email</label>\n            <InputText \n              id=\"email\" \n              v-model=\"email\" \n              type=\"email\" \n              placeholder=\"seu@email.com\"\n              class=\"w-full\"\n              required\n            />\n          </div>\n          \n          <div class=\"field\">\n            <label for=\"password\">Senha</label>\n            <Password \n              id=\"password\" \n              v-model=\"password\" \n              placeholder=\"********\"\n              :feedback=\"false\"\n              toggleMask\n              class=\"w-full\"\n              required\n            />\n          </div>\n          \n          <div class=\"field-checkbox\">\n            <Checkbox id=\"remember\" v-model=\"remember\" binary />\n            <label for=\"remember\">Lembrar-me</label>\n          </div>\n          \n          <Button \n            type=\"submit\" \n            label=\"Entrar\" \n            icon=\"pi pi-sign-in\" \n            class=\"w-full\"\n            :loading=\"loading\"\n          />\n          \n          <div class=\"text-center mt-3\">\n            <a href=\"#\" class=\"text-primary\">Esqueceu a senha?</a>\n          </div>\n        </form>\n      </template>\n    </Card>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useToast } from 'primevue/usetoast';\nimport Card from 'primevue/card';\nimport InputText from 'primevue/inputtext';\nimport Password from 'primevue/password';\nimport Button from 'primevue/button';\nimport Checkbox from 'primevue/checkbox';\nimport Toast from 'primevue/toast';\n\nconst router = useRouter();\nconst toast = useToast();\n\nconst email = ref('');\nconst password = ref('');\nconst remember = ref(false);\nconst loading = ref(false);\n\nasync function handleLogin() {\n  loading.value = true;\n  try {\n    // const response = await fetch('/api/login', {\n    //   method: 'POST',\n    //   headers: {'Content-Type': 'application/json'},\n    //   body: JSON.stringify({email: email.value, password: password.value})\n    // });\n    \n    toast.add({severity: 'success', summary: 'Sucesso', detail: 'Login realizado', life: 3000});\n    // router.push('/dashboard');\n  } catch (error) {\n    toast.add({severity: 'error', summary: 'Erro', detail: 'Credenciais inválidas', life: 3000});\n  } finally {\n    loading.value = false;\n  }\n}\n</script>"
  },
  "dashboard": {
    "description": "Dashboard com cards de estatísticas",
    "template": "<template>\n  <div class=\"dashboard p-4\">\n    <h1 class=\"mb-4\">Dashboard</h1>\n    \n    <div class=\"grid\">\n      <div class=\"col-12 md:col-6 lg:col-3\">\n        <Card>\n          <template #content>\n            <div class=\"flex justify-content-between align-items-center\">\n              <div>\n                <div class=\"text-500 mb-1\">Usuários</div>\n                <div class=\"text-3xl font-bold\">1,234</div>\n              </div>\n              <i class=\"pi pi-users text-4xl text-blue-500\"></i>\n            </div>\n          </template>\n        </Card>\n      </div>\n      \n      <div class=\"col-12 md:col-6 lg:col-3\">\n        <Card>\n          <template #content>\n            <div class=\"flex justify-content-between align-items-center\">\n              <div>\n                <div class=\"text-500 mb-1\">Vendas</div>\n                <div class=\"text-3xl font-bold\">R$ 45,678</div>\n              </div>\n              <i class=\"pi pi-shopping-cart text-4xl text-green-500\"></i>\n            </div>\n          </template>\n        </Card>\n      </div>\n      \n      <div class=\"col-12 md:col-6 lg:col-3\">\n        <Card>\n          <template #content>\n            <div class=\"flex justify-content-between align-items-center\">\n              <div>\n                <div class=\"text-500 mb-1\">Pedidos</div>\n                <div class=\"text-3xl font-bold\">567</div>\n              </div>\n              <i class=\"pi pi-box text-4xl text-orange-500\"></i>\n            </div>\n          </template>\n        </Card>\n      </div>\n      \n      <div class=\"col-12 md:col-6 lg:col-3\">\n        <Card>\n          <template #content>\n            <div class=\"flex justify-content-between align-items-center\">\n              <div>\n                <div class=\"text-500 mb-1\">Taxa Conv.</div>\n                <div class=\"text-3xl font-bold\">12.5%</div>\n              </div>\n              <i class=\"pi pi-chart-line text-4xl text-purple-500\"></i>\n            </div>\n          </template>\n        </Card>\n      </div>\n    </div>\n    \n    <div class=\"grid mt-4\">\n      <div class=\"col-12 lg:col-8\">\n        <Card>\n          <template #title>Vendas Recentes</template>\n          <template #content>\n            <DataTable :value=\"recentSales\" :rows=\"5\">\n              <Column field=\"id\" header=\"ID\"></Column>\n              <Column field=\"customer\" header=\"Cliente\"></Column>\n              <Column field=\"amount\" header=\"Valor\"></Column>\n              <Column field=\"status\" header=\"Status\">\n                <template #body=\"slotProps\">\n                  <Tag :severity=\"getSeverity(slotProps.data.status)\" :value=\"slotProps.data.status\" />\n                </template>\n              </Column>\n            </DataTable>\n          </template>\n        </Card>\n      </div>\n      \n      <div class=\"col-12 lg:col-4\">\n        <Card>\n          <template #title>Ações Rápidas</template>\n          <template #content>\n            <div class=\"flex flex-column gap-2\">\n              <Button label=\"Novo Pedido\" icon=\"pi pi-plus\" class=\"w-full\" />\n              <Button label=\"Relatórios\" icon=\"pi pi-chart-bar\" class=\"w-full\" severity=\"secondary\" />\n              <Button label=\"Configurações\" icon=\"pi pi-cog\" class=\"w-full\" severity=\"secondary\" />\n            </div>\n          </template>\n        </Card>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue';\nimport Card from 'primevue/card';\nimport DataTable from 'primevue/datatable';\nimport Column from 'primevue/column';\nimport Button from 'primevue/button';\nimport Tag from 'primevue/tag';\n\nconst recentSales = ref([\n  {id: 1, customer: 'João Silva', amount: 'R$ 1.234', status: 'Concluído'},\n  {id: 2, customer: 'Maria Santos', amount: 'R$ 567', status: 'Pendente'},\n  {id: 3, customer: 'Pedro Costa', amount: 'R$ 890', status: 'Concluído'},\n  {id: 4, customer: 'Ana Oliveira', amount: 'R$ 2.345', status: 'Processando'},\n  {id: 5, customer: 'Carlos Lima', amount: 'R$ 678', status: 'Concluído'}\n]);\n\nfunction getSeverity(status) {\n  const map = {\n    'Concluído': 'success',\n    'Pendente': 'warning',\n    'Processando': 'info'\n  };\n  return map[status] || 'info';\n}\n</script>"
  }
}
