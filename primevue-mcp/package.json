{
  "name": "primevue-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server para PrimeVue - Componentes e templates Vue 3",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "primevue-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-data",
    "copy-data": "cp -r src/data dist/ || xcopy /E /I /Y src\\data dist\\data",
    "dev": "npm run build && node dist/index.js",
    "test": "node dist/index.js"
  },
  "keywords": ["mcp", "primevue", "vue3", "components"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
