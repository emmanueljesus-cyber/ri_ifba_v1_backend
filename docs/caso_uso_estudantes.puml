@startuml DiagramaCasoUso_Estudantes

!theme plain
skinparam actorStyle awesome
skinparam packageBackgroundColor #FFFFCC
skinparam usecaseBackgroundColor #FFFFC0

title Sistema do Refeitório Institucional - Estudantes

left to right direction

actor "Usuário" as Usuario
actor "Estudante\nBolsista" as Bolsista
actor "Estudante\nNão Bolsista" as NaoBolsista

Usuario <|-- Bolsista
Usuario <|-- NaoBolsista

rectangle "Sistema do Refeitório Institucional - Estudantes" {
    
    ' Casos de uso comuns
    usecase "Autenticar-se" as UC_Auth
    usecase "Visualizar Cardápio\nSemanal/Diário" as UC_Cardapio
    
    ' Casos de uso do Bolsista
    usecase "Gerenciar Perfil" as UC_Perfil
    usecase "Informar Preferência\nAlimentar" as UC_Preferencia
    usecase "Selecionar Dias\nde Uso" as UC_Dias
    usecase "Atualizar Foto\nde Perfil" as UC_Foto
    usecase "Justificar Faltas" as UC_Justificar
    usecase "Antecipada" as UC_Antecipada
    usecase "Posterior" as UC_Posterior
    usecase "Anexar Documento" as UC_Anexar
    usecase "Ver Histórico de\nRefeições" as UC_Historico
    usecase "Ver Notificações" as UC_Notificacoes
    
    ' Casos de uso do Não Bolsista
    usecase "Entrar na Fila\nde Extra" as UC_FilaExtra
    usecase "Ver Posição\nna Fila" as UC_Posicao
    
    ' Relacionamentos Usuario
    Usuario --> UC_Auth
    Usuario --> UC_Cardapio
    
    ' Relacionamentos Bolsista
    Bolsista --> UC_Perfil
    Bolsista --> UC_Preferencia
    Bolsista --> UC_Dias
    Bolsista --> UC_Foto
    Bolsista --> UC_Justificar
    Bolsista --> UC_Historico
    Bolsista --> UC_Notificacoes
    
    ' Relacionamentos Não Bolsista
    NaoBolsista --> UC_FilaExtra
    
    ' Extends e Includes
    UC_Justificar ..> UC_Antecipada : <<extend>>
    UC_Justificar ..> UC_Posterior : <<extend>>
    UC_Posterior ..> UC_Anexar : <<include>>
    UC_FilaExtra ..> UC_Posicao : <<extend>>
    
    ' Perfil agrupa funcionalidades
    UC_Perfil ..> UC_Preferencia : <<include>>
    UC_Perfil ..> UC_Dias : <<include>>
    UC_Perfil ..> UC_Foto : <<include>>
    
    ' Notas
    note right of UC_Antecipada
        Válida se justificado
        até o horário limite
    end note
    
    note right of UC_Posterior
        Anexo obrigatório
        (PDF/JPG/PNG)
    end note
    
    note right of UC_Dias
        Segunda a Sexta
        Apenas bolsistas
    end note
}

@enduml
